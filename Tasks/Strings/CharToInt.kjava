public class CharToInt {
    public static void main(String[] args) {

        char ch1 = 'A';
        char ch2 = 'a';
        char ch3 = '0';

        System.out.println("Unicode of A: " + (int) ch1);
        System.out.println("Unicode of a: " + (int) ch2);
        System.out.println("Unicode of 0: " + (int) ch3);
    }
}
